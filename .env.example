# Optional absolute endpoint. Leave empty in development to use the Vite /api proxy.
VITE_ANALYSIS_API_URL=/api/v1

# Local runtime (scripts/dev.sh defaults)
DXA_API_PORT=8001
DXA_WEB_PORT=5173
ANALYSIS_API_TARGET=http://127.0.0.1:8001

# Connect only a previously de-identified osseo-apex export.
OSSEO_DATASET_ROOT=/secure/path/apex-dataset
OSSEO_ANNOTATION_ROOT=/secure/path/apex-annotations
OSSEO_LONGITUDINAL_ROOT=/secure/path/longitudinal-registry
OSSEO_EXCLUSION_LOG=/secure/path/runtime/exclusions.jsonl
OSSEO_AUDIT_LOG=/secure/path/runtime/audit.jsonl
OSSEO_AUDIT_HMAC_KEY=replace-with-a-separate-at-least-16-byte-secret

# Both values intentionally keep the clinical release gate closed by default.
# Configure authentication at the trusted reverse proxy before pilot data are used.
OSSEO_AUTH_MODE=disabled
OSSEO_CLINICAL_VALIDATION_ID=

# Required only while producing a new dataset export; never commit this value.
OSSEO_PSEUDONYM_KEY=replace-with-at-least-16-bytes

# Primary competition service: persistent job database, images and expert revisions.
DXAQC_DATA_DIR=./data/runtime
# Defaults to the competition UI. Set research only for the legacy workbench.
VITE_WORKSPACE=competition
