{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osseo.ai/schemas/dxa-longitudinal-v2.json",
  "title": "DXA longitudinal comparison result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "comparisonId", "engineVersion", "decisionBasis", "baselineStudyId", "currentStudyId", "patientGroupId", "baselineDate", "currentDate", "intervalMonths", "lscProfileId", "lscProfileVersion", "status", "assumed", "checks", "sites", "recommendationCode", "comparedAt"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "comparisonId": { "pattern": "^CMP-[A-F0-9]{20}$" },
    "engineVersion": { "const": "osseo-longitudinal/2.0.0" },
    "decisionBasis": { "const": "deterministic-quality-gates" },
    "baselineStudyId": { "pattern": "^ST-[A-F0-9]{20}$" },
    "currentStudyId": { "pattern": "^ST-[A-F0-9]{20}$" },
    "patientGroupId": { "pattern": "^PG-[A-F0-9]{20}$" },
    "baselineDate": { "type": "string", "format": "date" },
    "currentDate": { "type": "string", "format": "date" },
    "intervalMonths": { "type": "integer", "minimum": 0 },
    "lscProfileId": { "pattern": "^LSC-[A-Z0-9._-]{4,76}$" },
    "lscProfileVersion": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "crossCalibrationId": { "type": ["string", "null"] },
    "status": { "enum": ["comparable", "review", "not-comparable"] },
    "assumed": { "const": false },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "passed", "critical", "detail"],
        "properties": {
          "id": { "enum": ["patient", "chronology", "protocol", "structured_bmd", "quality", "positioning", "roi", "device", "cross_calibration", "lsc_profile"] },
          "label": { "type": "string" },
          "status": { "enum": ["pass", "review", "block"] },
          "passed": { "type": "boolean" },
          "critical": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "baselineBmd", "currentBmd", "absoluteChange", "percentChange", "lscPercent", "status"],
        "properties": {
          "site": { "enum": ["l1-l4", "total-hip", "femoral-neck"] },
          "baselineBmd": { "type": "number", "exclusiveMinimum": 0 },
          "currentBmd": { "type": "number", "exclusiveMinimum": 0 },
          "absoluteChange": { "type": "number" },
          "percentChange": { "type": "number" },
          "lscPercent": { "type": "number", "exclusiveMinimum": 0 },
          "status": { "enum": ["significant-gain", "stable", "significant-loss", "not-comparable"] }
        }
      }
    },
    "recommendationCode": { "enum": ["INTERPRET_WITH_CLINICAL_CONTEXT", "EXPERT_REVIEW_REQUIRED", "COMPARISON_BLOCKED"] },
    "comparedAt": { "type": "string", "format": "date-time" }
  }
}
